<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="retro_companion_credentials_keyset.xml" />
        <exclude domain="file" path="datastore/retro_user_prefs.preferences_pb" />
        <exclude domain="file" path="datastore/retro_response_cache.preferences_pb" />
        <exclude domain="file" path="datastore/retro_unlock_polling.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="retro_companion_credentials_keyset.xml" />
        <exclude domain="file" path="datastore/retro_user_prefs.preferences_pb" />
        <exclude domain="file" path="datastore/retro_response_cache.preferences_pb" />
        <exclude domain="file" path="datastore/retro_unlock_polling.preferences_pb" />
    </device-transfer>
</data-extraction-rules>